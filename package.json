{
  "name": "getworth-app",
  "version": "1.0.0",
  "description": "AI-Powered Item Valuation App",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/design-lint.mjs",
    "test": "node scripts/check-contrast.mjs && node scripts/design-lint.mjs && node tests/reputation.integration.mjs && node --test tests/valuation-guard.test.mjs tests/design-lint.test.mjs tests/ui-css-contract.test.mjs tests/ui-interaction.test.mjs tests/trust-copy.test.mjs tests/persistence-rows.test.mjs tests/observation-payloads.test.mjs",
    "test:mutation": "node tests/mutations/run.mjs && node tests/mutations/ui-run.mjs",
    "test:mutation:ui": "node tests/mutations/ui-run.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "autoprefixer": "^10.4.16",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^8.1.0",
    "vite-plugin-pwa": "^1.2.0"
  }
}
